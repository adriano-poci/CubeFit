        s_sel = np.asarray(
            r3["sample_selection"]["spaxels"],
            dtype=np.int64,
        )

        p_sel = np.asarray(
            r3["sample_selection"]["populations"],
            dtype=np.int64,
        )

        M3 = f3["/HyperCube/models"]
        M20 = f20["/HyperCube/models"]

        pair_cos = []
        near_3 = []
        near_20 = []

        for s in s_sel:
            a = np.asarray(
                M3[int(s), :, p_sel, :],
                dtype=np.float64,
