            b = np.asarray(
                M20[int(s), :, p_sel, :],
                dtype=np.float64,
            )

            a = a[:, :, keep3]
            b = b[:, :, keep20]

            a /= np.maximum(
                np.linalg.norm(
                    a,
                    axis=2,
                    keepdims=True,
                ),
                1e-300,
            )

            b /= np.maximum(
                np.linalg.norm(
                    b,
                    axis=2,
                    keepdims=True,
                ),
                1e-300,
            )

            for j in range(
