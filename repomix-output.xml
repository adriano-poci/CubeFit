    method='fsf', varIMF=False, source='ppxf', redraw=False,
    pplots=['sfh', 'spec', 'mw', 'proj'], **kwargs)

reconstruct_modelcube_fast(...)
reconstruct_modelcube_fast_parallel(...)
modelcube_status(...)
parallel_spectrum_plots(...)
plot_best_worst_spectrum_fits_stacked(...)
