def plot_population_radial_profiles(arSOL, umetals, uages, ualphas, intData,
    cRadius, otypes, dataMax, save_path=None):
    """
    Plot intrinsic cylindrical radial profiles of the fitted stellar
    populations for the three orbital families.

    The complete fitted SSP distribution of each dynamical component is
    projected into intrinsic cylindrical-radius bins according to that
    component's intrinsic fitted-mass distribution. Components are then
    combined separately for z-tubes, x-tubes, and box orbits before computing
    population-weighted age, metallicity, and alpha enhancement.

    Parameters
    ----------
    arSOL : ndarray
        Fitted SSP coefficients with shape
        ``(C, nMetals, nAges, nAlphas)``.
    umetals : ndarray
        SSP metallicities with shape ``(nMetals,)``.
    uages : ndarray
        SSP ages with shape ``(nAges,)``.
    ualphas : ndarray
        SSP alpha enhancements with shape ``(nAlphas,)``.
    intData : ndarray
        Intrinsic component data with shape ``(18, C, nIntrinsic)``.
        Index 1 is fitted mass, index 3 is intrinsic X, and index 4 is
        intrinsic Y.
    cRadius : ndarray
        Cylindrical radial-bin coordinates constructed by ``loadCubeFit``.
        These are treated in the same way as the radial coordinates used by
        the existing intrinsic-profile machinery.
    otypes : ndarray
        Intrinsic component types: 0 for z-tubes, 1 for x-tubes, and 2 for
        box orbits.
    save_path : pathlib.Path or str, optional
        Output figure path.

    Returns
    -------
    out : dict
        Figure, radial coordinates, family-resolved SSP distributions,
        population masses, and radial population properties.

    Raises
    ------
    ValueError
        If supplied arrays have inconsistent dimensions.
    RuntimeError
        If no positive fitted population or intrinsic radial mass is
        available.

    Examples
    --------
    >>> out = plot_population_radial_profiles(
    ...     arSOL, umetals, uages, ualphas, intData, cRadius, otypes,
    ...     save_path="population_radial_profiles.png")
    """
    arSOL = np.asarray(arSOL, dtype=np.float64)
    umetals = np.asarray(umetals, dtype=np.float64).ravel(order="C")
    uages = np.asarray(uages, dtype=np.float64).ravel(order="C")
    ualphas = np.asarray(ualphas, dtype=np.float64).ravel(order="C")
    cRadius = np.asarray(cRadius, dtype=np.float64).ravel(order="C")
    otypes = np.asarray(otypes, dtype=np.int64).ravel(order="C")
    intData = np.ma.asarray(intData, dtype=np.float64)
    dataMax = float(np.nanmax(np.asarray(dataMax, dtype=np.float64)))

    if arSOL.ndim != 4:
        raise ValueError(
            "arSOL must have shape (C, nMetals, nAges, nAlphas).")

    C, nMetals, nAges, nAlphas = map(int, arSOL.shape)

    if umetals.size != nMetals:
        raise ValueError("umetals is inconsistent with arSOL.")
    if uages.size != nAges:
        raise ValueError("uages is inconsistent with arSOL.")
    if ualphas.size != nAlphas:
        raise ValueError("ualphas is inconsistent with arSOL.")
    if otypes.size != C:
        raise ValueError("otypes is inconsistent with arSOL.")
    if intData.ndim != 3 or intData.shape[0] < 5:
        raise ValueError("intData must have shape (>=5, C, nIntrinsic).")
    if intData.shape[1] != C:
        raise ValueError("intData component dimension is inconsistent "
            "with arSOL.")
    if cRadius.size < 1:
        raise ValueError("cRadius is empty.")
    if not np.all(np.isfinite(cRadius)):
        raise ValueError("cRadius contains non-finite values.")
    if np.any(np.diff(cRadius) <= 0.0):
        raise ValueError("cRadius must be strictly increasing.")
    if not np.all(np.isin(otypes, (0, 1, 2))):
        raise ValueError(
            f"Invalid intrinsic orbital types: {np.unique(otypes)}.")

    component_mass = np.sum(arSOL, axis=(1, 2, 3))
    total_population_mass = float(np.sum(component_mass))

    if not np.isfinite(total_population_mass) or total_population_mass <= 0.0:
        raise RuntimeError("The fitted solution has no positive population "
            "mass.")

    # Match the existing broadBetaCompsCyl convention: cRadius gives the
    # lower radial coordinates and one open outer edge catches all remaining
    # intrinsic cells.
    radial_edges = np.insert(cRadius, 0, 0.0)
    nRad = int(cRadius.size)
    radial_coordinates = np.sqrt(radial_edges[:-1]*radial_edges[1:])
    radial_coordinates[0] = cRadius[0]

    XX = np.ma.asarray(intData[3], dtype=np.float64)
    YY = np.ma.asarray(intData[4], dtype=np.float64)
    fitMass = np.ma.asarray(intData[1], dtype=np.float64)
    intrinsic_radius = np.ma.sqrt(XX*XX+YY*YY)

    component_radial_mass = np.zeros((C, nRad), dtype=np.float64)

    for cc in range(C):
        radius = np.ma.asarray(intrinsic_radius[cc]).filled(np.nan)
        mass = np.ma.asarray(fitMass[cc]).filled(0.0)

        valid = np.isfinite(radius) & np.isfinite(mass) & (mass > 0.0)

        if not np.any(valid):
            continue

        radius_valid = radius[valid]
        mass_valid = mass[valid]

        for rr in range(nRad):
            if rr == 0:
                wss = ((radius_valid >= radial_edges[rr])
                    & (radius_valid <= radial_edges[rr+1]))
            else:
                wss = ((radius_valid > radial_edges[rr])
                    & (radius_valid <= radial_edges[rr+1]))

            if np.any(wss):
                component_radial_mass[cc, rr] = np.sum(mass_valid[wss])

        radial_total = float(np.sum(component_radial_mass[cc]))

    # ------------------------------------------------------------------
    # Component stellar-population properties.
    #
    # arSOL determines the mean population carried by each fitted dynamical
    # component. The absolute coefficient normalization is deliberately
    # removed here; intrinsic radial weighting is supplied by fitMass below,
    # exactly analogous to the aperMass weighting used by the 2-D maps.
    # ------------------------------------------------------------------
    component_mass = np.sum(arSOL, axis=(1, 2, 3))

    zz, tt, aa = np.meshgrid(
        umetals, uages, ualphas, indexing="ij")

    component_age = np.divide(
        np.sum(arSOL*tt[None, :, :, :], axis=(1, 2, 3)),
        component_mass,
        out=np.full(C, np.nan, dtype=np.float64),
        where=component_mass > 0.0)

    component_metal = np.divide(
        np.sum(arSOL*zz[None, :, :, :], axis=(1, 2, 3)),
        component_mass,
        out=np.full(C, np.nan, dtype=np.float64),
        where=component_mass > 0.0)

    component_alpha = np.divide(
        np.sum(arSOL*aa[None, :, :, :], axis=(1, 2, 3)),
        component_mass,
        out=np.full(C, np.nan, dtype=np.float64),
        where=component_mass > 0.0)

    valid_component = ((component_mass > 0.0)
        & np.isfinite(component_age)
        & np.isfinite(component_metal)
        & np.isfinite(component_alpha)
        & (np.sum(component_radial_mass, axis=1) > 0.0))

    if not np.any(valid_component):
        raise RuntimeError("No fitted component has positive intrinsic radial "
            "mass.")

    families = (
        (0, r"$z$-tube", "tab:blue"),
        (1, r"$x$-tube", "tab:orange"),
        (2, "Box orbits", "tab:green"),
    )

    nFamilies = len(families)

    family_radial_mass = np.zeros((nFamilies, nRad), dtype=np.float64)

    mean_age = np.full(
        (nFamilies, nRad), np.nan, dtype=np.float64)
    mean_metal = np.full(
        (nFamilies, nRad), np.nan, dtype=np.float64)
    mean_alpha = np.full(
        (nFamilies, nRad), np.nan, dtype=np.float64)

    sigma_age = np.full(
        (nFamilies, nRad), np.nan, dtype=np.float64)
    sigma_metal = np.full(
        (nFamilies, nRad), np.nan, dtype=np.float64)
    sigma_alpha = np.full(
        (nFamilies, nRad), np.nan, dtype=np.float64)

    component_properties = (component_age, component_metal, component_alpha)
    family_means = (mean_age, mean_metal, mean_alpha)
    family_sigmas = (sigma_age, sigma_metal, sigma_alpha)

    # ------------------------------------------------------------------
    # Intrinsic dynamical-mass weighting.
    #
    # At each radius the population property of an orbital family is the
    # fitMass-weighted mean of the fitted population properties of its
    # constituent dynamical components.
    # ------------------------------------------------------------------
    for ff, (type_id, _, _) in enumerate(families):
        family = valid_component & (otypes == type_id)

        if not np.any(family):
            continue

        weights = component_radial_mass[family]
        family_radial_mass[ff] = np.sum(weights, axis=0)

        for prop, mean, sigma in zip(
            component_properties, family_means, family_sigmas):

            numerator = np.sum(weights*prop[family, None], axis=0)

            mean[ff] = np.divide(numerator, family_radial_mass[ff],
                out=np.full(nRad, np.nan, dtype=np.float64),
                where=family_radial_mass[ff] > 0.0)

            variance = np.sum(weights*(prop[family, None]-mean[ff, None, :])**2,
                axis=0)

            sigma[ff] = np.sqrt(np.divide(variance, family_radial_mass[ff],
                out=np.full(nRad, np.nan, dtype=np.float64),
                where=family_radial_mass[ff] > 0.0))

    total_intrinsic_mass = float(np.sum(component_radial_mass))
    family_intrinsic_mass = float(np.sum(family_radial_mass))

    if not np.isclose(family_intrinsic_mass, total_intrinsic_mass,
        rtol=1e-12, atol=1e-12*max(1.0, total_intrinsic_mass)):
        raise RuntimeError("Orbital-family radial binning does not conserve "
            "intrinsic dynamical mass.")

    family_mass_fraction = np.divide(family_radial_mass,
        np.sum(family_radial_mass, axis=0)[None, :],
        out=np.zeros_like(family_radial_mass),
        where=np.sum(family_radial_mass, axis=0)[None, :] > 0.0)

    print("Population radial-profile dynamical-mass conservation: "
        f"{family_intrinsic_mass/total_intrinsic_mass:.16f}")

    # Plot at the radial-bin coordinates already constructed by loadCubeFit.
    # The same x-coordinate is used for all three properties.
    fig, axes = plt.subplots(3, 1, figsize=(7.0, 8.0), sharex=True)

    properties = (
        (mean_age, sigma_age, r"$\langle t\rangle\ [{\rm Gyr}]$"),
        (mean_metal, sigma_metal, r"$\langle[Z/H]\rangle$"),
        (mean_alpha, sigma_alpha, r"$\langle[\alpha/{\rm Fe}]\rangle$"),
    )

    for pp, (values, sigma, ylabel) in enumerate(properties):
        ax = axes[pp]

        for ff, (_, label, color) in enumerate(families):
            valid = (np.isfinite(values[ff]) & np.isfinite(sigma[ff])
                & (family_radial_mass[ff] > 0.0))

            if not np.any(valid):
                continue

            radius = np.log10(radial_coordinates[valid])
            mean = values[ff, valid]
            std = sigma[ff, valid]

            ax.fill_between(radius, mean-std, mean+std, color=color,
                alpha=0.20, linewidth=0.0)

            ax.plot(radius, mean, color=color, lw=1.5, marker="o", ms=3.5,
                label=label)

        ax.axvline(np.log10(dataMax), color="k", ls="--", lw=1.0)
        ax.set_ylabel(ylabel)

        if pp < 2:
            ax.tick_params(axis="x", which="both", labelbottom=False)

    axes[-1].set_xlabel(r"$\log_{10}(R_{\rm cyl}\ [{\rm arcsec}])$")
    axes[0].legend(frameon=False, loc="best")

    fig.subplots_adjust(left=0.13, right=0.97, bottom=0.09, top=0.98,
        hspace=0.0)

    if save_path is not None:
        save_path = plp.Path(save_path)
        save_path.parent.mkdir(parents=True, exist_ok=True)
        fig.savefig(save_path, dpi=300, bbox_inches="tight",
            pad_inches=0.03)

    return {
        "figure": fig,
        "radial_coordinates": radial_coordinates,
        "radial_edges": radial_edges,
        "component_radial_mass": component_radial_mass,
        "family_radial_mass": family_radial_mass,
        "family_mass_fraction": family_mass_fraction,
        "component_mass": component_mass,
        "component_age": component_age,
        "component_metallicity": component_metal,
        "component_alpha": component_alpha,
        "mean_age": mean_age,
        "mean_metallicity": mean_metal,
        "mean_alpha": mean_alpha,
        "sigma_age": sigma_age,
        "sigma_metallicity": sigma_metal,
        "sigma_alpha": sigma_alpha,
        "valid_component": valid_component,
        "intrinsic_mass": total_intrinsic_mass,
    }

# ------------------------------------------------------------------------------

def plot_x_global_projections(h5_path: str, save_path=None,
    compare_dset="/X_global_pure_kkt", cmap="inferno", log_floor=1e-6,
    show=False):
    """
    Plot physical population projections directly from ``/X_global``.

    The final physical ``(C, P)`` solution is projected into global SSP and
    component-population spaces without requiring ``/ModelCube`` or reading
    ``/HyperCube/models``.

    If ``compare_dset`` exists, the comparison solution is analysed against
    ``/X_global``. This is intended primarily for comparing the stored raw
    zero-regularisation KKT solution with the accepted minimum-L2 solution.

    Parameters
    ----------
    h5_path : str
        CubeFit HDF5 file containing ``/X_global`` and SSP coordinates.
    save_path : str or pathlib.Path, optional
        Main figure output path. The comparison figure uses the same stem with
        ``_comparison`` appended. Default is None.
    compare_dset : str or None, optional
        HDF5 dataset to compare with ``/X_global``. Default is
        ``"/X_global_pure_kkt"``. Missing datasets are silently ignored.
    cmap : str, optional
        Matplotlib colormap. Default is ``"inferno"``.
    log_floor : float, optional
        Smallest displayed fraction relative to each projection group's
        maximum positive bin. Default is ``1e-6``.
    show : bool, optional
        Display figures interactively. Default is False.

    Returns
    -------
    out : dict
        Final-solution projections, component properties, and comparison
        diagnostics when ``compare_dset`` is available.

    Raises
    ------
    RuntimeError
        If required HDF5 datasets are absent or the solution has zero mass.
    ValueError
        If solution or SSP dimensions are inconsistent.

    Examples
    --------
    >>> out = plot_x_global_projections(
    ...     "hypercube_109_00.h5",
    ...     save_path="x_global_projections.png")
    """
    from CubeFit.hdf5_manager import open_h5

    log_floor = float(log_floor)
    if not 0.0 < log_floor < 1.0:
        raise ValueError("log_floor must lie strictly between zero and one.")

    required = ("/X_global", "/SSPMetals", "/SSPAges", "/SSPAlphas")

    with open_h5(h5_path, role="reader", swmr=True) as f:
        missing = [name for name in required if name not in f]
        if missing:
            raise RuntimeError(f"Missing required datasets: {missing}.")

        X = np.asarray(f["/X_global"][...], dtype=np.float64)
        metals = np.asarray(
            f["/SSPMetals"][...], dtype=np.float64).ravel(order="C")
        ages = np.asarray(
            f["/SSPAges"][...], dtype=np.float64).ravel(order="C")
        alphas = np.asarray(
            f["/SSPAlphas"][...], dtype=np.float64).ravel(order="C")

        X_compare = None
        if compare_dset is not None and compare_dset in f:
            X_compare = np.asarray(f[compare_dset][...], dtype=np.float64)

    P = int(metals.size*ages.size*alphas.size)

    def _physical_solution(values, name):
        values = np.asarray(values, dtype=np.float64)

        if values.ndim == 1:
            if values.size % P != 0:
                raise ValueError(
                    f"{name} size {values.size} is incompatible with P={P}.")
            values = values.reshape(values.size//P, P)
        elif values.ndim != 2:
            raise ValueError(f"{name} must have shape (C, P) or (C*P,).")

        if values.shape[1] != P:
            raise ValueError(
                f"{name} P={values.shape[1]}; SSP grid requires P={P}.")
        if np.any(~np.isfinite(values)):
            raise ValueError(f"{name} contains non-finite values.")
        if np.any(values < 0.0):
            raise ValueError(f"{name} contains negative coefficients.")

        return values

    X = _physical_solution(X, "/X_global")
    C = int(X.shape[0])
    pop_shape = (metals.size, ages.size, alphas.size)

    if X_compare is not None:
        X_compare = _physical_solution(X_compare, compare_dset)
        if X_compare.shape != X.shape:
            raise ValueError(
                f"{compare_dset} shape {X_compare.shape}; expected {X.shape}.")

    def _project(values):
        solution = values.reshape((C,)+pop_shape, order="C")
        total = float(np.sum(solution))

        if not np.isfinite(total) or total <= 0.0:
            raise RuntimeError("Population solution has no positive mass.")

        frac = solution/total
        age_metal = np.sum(frac, axis=(0, 3))
        age_alpha = np.sum(frac, axis=(0, 1))
        metal_alpha = np.sum(frac, axis=(0, 2))
        age_dist = np.sum(frac, axis=(0, 1, 3))
        comp_age = np.sum(frac, axis=(1, 3))
        comp_metal = np.sum(frac, axis=(2, 3))
        comp_alpha = np.sum(frac, axis=(1, 2))
        comp_mass = np.sum(frac, axis=(1, 2, 3))

        return {
            "solution": solution,
            "total_mass": total,
            "fraction": frac,
            "age_metallicity": age_metal,
            "age_alpha": age_alpha,
            "metallicity_alpha": metal_alpha,
            "age_distribution": age_dist,
            "component_age": comp_age,
            "component_metallicity": comp_metal,
            "component_alpha": comp_alpha,
            "component_mass_fraction": comp_mass,
        }

    final = _project(X)

    zz, tt, aa = np.meshgrid(metals, ages, alphas, indexing="ij")
    arSOL = final["solution"]
    component_mass = np.sum(arSOL, axis=(1, 2, 3))

    mean_age = np.divide(
        np.sum(arSOL*tt[None, :, :, :], axis=(1, 2, 3)), component_mass,
        out=np.full(C, np.nan, dtype=np.float64), where=component_mass > 0.0)
    mean_metal = np.divide(
        np.sum(arSOL*zz[None, :, :, :], axis=(1, 2, 3)), component_mass,
        out=np.full(C, np.nan, dtype=np.float64), where=component_mass > 0.0)
    mean_alpha = np.divide(
        np.sum(arSOL*aa[None, :, :, :], axis=(1, 2, 3)), component_mass,
        out=np.full(C, np.nan, dtype=np.float64), where=component_mass > 0.0)

    def _edges(values):
        values = np.asarray(values, dtype=np.float64)
        if values.size == 1:
            return np.array(
                [values[0]-0.5, values[0]+0.5], dtype=np.float64)

        edges = np.empty(values.size+1, dtype=np.float64)
        edges[1:-1] = 0.5*(values[:-1]+values[1:])
        edges[0] = values[0]-0.5*(values[1]-values[0])
        edges[-1] = values[-1]+0.5*(values[-1]-values[-2])
        return edges

    def _log_norm(arrays):
        positive = np.concatenate([
            value[value > 0.0].ravel() for value in arrays
            if np.any(value > 0.0)])

        if positive.size == 0:
            raise RuntimeError("No positive projected population mass exists.")

        vmax = float(np.max(positive))
        vmin = max(vmax*log_floor, float(np.min(positive)))
        return mcolors.LogNorm(vmin=vmin, vmax=vmax)

    age_edges = _edges(ages)
    metal_edges = _edges(metals)
    alpha_edges = _edges(alphas)
    comp_edges = np.arange(C+1, dtype=np.float64)-0.5

    # SSP and component projections deliberately use independent scales.
    ssp_norm = _log_norm((
        final["age_metallicity"], final["age_alpha"],
        final["metallicity_alpha"]))
    comp_norm = _log_norm((
        final["component_age"], final["component_metallicity"],
        final["component_alpha"]))

    fig = plt.figure(figsize=(13.0, 10.0))
    gs = fig.add_gridspec(3, 3, height_ratios=(1.0, 1.0, 0.72),
        hspace=0.32, wspace=0.30)

    ax_am = fig.add_subplot(gs[0, 0])
    ax_aa = fig.add_subplot(gs[0, 1])
    ax_za = fig.add_subplot(gs[0, 2])
    ax_ca = fig.add_subplot(gs[1, 0])
    ax_cz = fig.add_subplot(gs[1, 1])
    ax_prop = fig.add_subplot(gs[1, 2])
    ax_age = fig.add_subplot(gs[2, :])

    mesh_ssp = ax_am.pcolormesh(
        age_edges, metal_edges, final["age_metallicity"], cmap=cmap,
        norm=ssp_norm, shading="flat")
    ax_am.set_xlabel(r"Age [Gyr]")
    ax_am.set_ylabel(r"$[Z/H]$")
    ax_am.set_title(r"Age--metallicity")

    ax_aa.pcolormesh(
        age_edges, alpha_edges, final["age_alpha"].T, cmap=cmap,
        norm=ssp_norm, shading="flat")
    ax_aa.set_xlabel(r"Age [Gyr]")
    ax_aa.set_ylabel(r"$[\alpha/{\rm Fe}]$")
    ax_aa.set_title(r"Age--$\alpha$")

    ax_za.pcolormesh(
        metal_edges, alpha_edges, final["metallicity_alpha"].T, cmap=cmap,
        norm=ssp_norm, shading="flat")
    ax_za.set_xlabel(r"$[Z/H]$")
    ax_za.set_ylabel(r"$[\alpha/{\rm Fe}]$")
    ax_za.set_title(r"Metallicity--$\alpha$")

    mesh_comp = ax_ca.pcolormesh(
        age_edges, comp_edges, final["component_age"], cmap=cmap,
        norm=comp_norm, shading="flat")
    ax_ca.set_xlabel(r"Age [Gyr]")
    ax_ca.set_ylabel("Component")
    ax_ca.set_title("Component--age")

    ax_cz.pcolormesh(
        metal_edges, comp_edges, final["component_metallicity"], cmap=cmap,
        norm=comp_norm, shading="flat")
    ax_cz.set_xlabel(r"$[Z/H]$")
    ax_cz.set_ylabel("Component")
    ax_cz.set_title("Component--metallicity")

    valid = component_mass > 0.0
    size = np.zeros(C, dtype=np.float64)

    if np.any(valid):
        size[valid] = 15.0+135.0*np.sqrt(
            component_mass[valid]/np.max(component_mass[valid]))

    scatter = ax_prop.scatter(
        mean_age[valid], mean_metal[valid], c=mean_alpha[valid],
        s=size[valid], cmap=cmap, edgecolor="none", alpha=0.8)
    ax_prop.set_xlabel(r"$\langle t\rangle$ [Gyr]")
    ax_prop.set_ylabel(r"$\langle[Z/H]\rangle$")
    ax_prop.set_title("Component population means")

    cbar_prop = fig.colorbar(scatter, ax=ax_prop, pad=0.02)
    cbar_prop.set_label(r"$\langle[\alpha/{\rm Fe}]\rangle$")

    ax_age.stairs(
        final["age_distribution"], age_edges, fill=True, alpha=0.35)
    ax_age.plot(
        ages, final["age_distribution"], marker="o", lw=1.0,
        label="minimum-L2")

    if X_compare is not None:
        raw = _project(X_compare)
        ax_age.plot(
            ages, raw["age_distribution"], marker="s", lw=1.0,
            linestyle="--", label="pure KKT")
        ax_age.legend(frameon=False)
    else:
        raw = None

    ax_age.set_xlabel(r"Age [Gyr]")
    ax_age.set_ylabel("Global coefficient fraction")
    ax_age.set_title("Global star-formation history")
    ax_age.set_xlim(age_edges[0], age_edges[-1])

    # Each heatmap row gets its own one-row colourbar.
    cbar_ssp = fig.colorbar(
        mesh_ssp, ax=(ax_am, ax_aa, ax_za), pad=0.015, fraction=0.025)
    cbar_ssp.set_label("Global SSP coefficient fraction")

    cbar_comp = fig.colorbar(
        mesh_comp, ax=(ax_ca, ax_cz), pad=0.015, fraction=0.025)
    cbar_comp.set_label("Component--SSP coefficient fraction")

    fig.suptitle(
        f"/X_global physical population projections: C={C}, P={P}",
        fontsize=12, y=0.995)

    comparison = None
    comparison_figure = None

    if raw is not None:
        delta = X-X_compare
        norm_final = float(np.linalg.norm(X))
        norm_raw = float(np.linalg.norm(X_compare))
        delta_l2 = float(np.linalg.norm(delta))
        delta_l1 = float(np.sum(np.abs(delta)))

        rel_l2 = delta_l2/max(norm_raw, 1e-300)
        rel_l1 = delta_l1/max(float(np.sum(np.abs(X_compare))), 1e-300)
        cosine = float(np.sum(X*X_compare)) \
            / max(norm_final*norm_raw, 1e-300)

        raw_nz = int(np.count_nonzero(X_compare > 0.0))
        final_nz = int(np.count_nonzero(X > 0.0))

        age_delta = (
            final["age_distribution"]-raw["age_distribution"])
        comp_delta = (
            final["component_mass_fraction"]
            - raw["component_mass_fraction"])

        comp_delta_l2 = np.linalg.norm(delta, axis=1)
        raw_comp_l2 = np.linalg.norm(X_compare, axis=1)
        final_comp_l2 = np.linalg.norm(X, axis=1)
        comp_cosine = np.divide(
            np.sum(X*X_compare, axis=1), raw_comp_l2*final_comp_l2,
            out=np.full(C, np.nan, dtype=np.float64),
            where=(raw_comp_l2 > 0.0) & (final_comp_l2 > 0.0))

        youngest = int(np.argmin(ages))
        young_age = float(ages[youngest])
        young_raw = float(raw["age_distribution"][youngest])
        young_final = float(final["age_distribution"][youngest])
        young_delta = young_final-young_raw

        print("\nPure-KKT versus minimum-L2")
        print(f"||x_KKT||_2          : {norm_raw:.8e}")
        print(f"||x_minL2||_2        : {norm_final:.8e}")
        print(f"norm reduction       : {1.0-norm_final/norm_raw:.6%}")
