        # optional input data for plots
        has_mask = ("/Mask" in f)
        mask_arr = np.asarray(f["/Mask"][...], bool) if has_mask else None
        obs = f["/ObsPix"][...] if "/ObsPix" in f else np.arange(nLSpec)

    best_processes, best_blas = cu.resolve_parallelism(CPU_PROCESSES,
