def _h5repack_inplace(path: Path) -> bool:
    tmp = path.with_suffix(path.suffix + ".tmp-repack")
    ok, out = _run(["h5repack", str(path), str(tmp)])
    if ok:
        try:
            os.replace(tmp, path)
            logger.log(f"[HDF5] h5repack succeeded; replaced {path}")
        except Exception as e:
