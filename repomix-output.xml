def _compute_yty(
    h5_path: str,
    s_ranges: list,
    keep_idx,
) -> float:
    """Compute y.T @ y once in the fitted data space."""
    yty = 0.0

    with open_h5(h5_path, role="reader") as f:
        DC = f["/DataCube"]

        for s0, s1 in s_ranges:
            Yt = np.asarray(
                DC[s0:s1, :],
                dtype=np.float64,
                order="C",
            )

            if keep_idx is not None:
                Yt = Yt[:, keep_idx]

            yty += float(np.sum(Yt * Yt))

    return yty

