write/report authoritative x

# streamActiveSetNNLS
build Q_ssp and smooth_scale
restore checkpoint OR establish feasible constrained initial state
while iteration < max_iter:
    ATAz = exact streamed $SA^{\mathsf T}ASz$
    gradient = data + smoothness + ridge + constraint multipliers
    if KKT satisfied:
        converged = True
        break
    choose genuine inactive KKT violators
    assemble reduced Gram on expanded support
    solve complete constrained reduced NNLS
    commit only accepted feasible state
    checkpoint

if converged and regularisation_scale == 0 and minimum_l2_at_zero:
    expand support intelligently
    assemble one expanded reduced Gram
    search secondary $L_2$ strength subject to RSS tolerance
    commit best acceptable lower-norm state

report residual, RMSE, smoothness, constraints, support, $L_2$ status
\end{lstlisting}

\section{Appendix B: equations at a glance}
\begin{align*}
D_j &= A_j^{\mathsf T}A_j, & S_j&=D_j^{-1/2}, & x&=Sz,\\
b_z &= SA^{\mathsf T}y, & G&=SA^{\mathsf T}AS,\\
\phi_{\rm data}(z)&=\tfrac{1}{2}z^{\mathsf T}Gz-b_z^{\mathsf T}z,\\
\phi_{\rm RSS}(x)&=\tfrac{1}{2}\lVert Ax-y\rVert_2^2,\\
\phi_{\rm smooth}(x)&=\tfrac{1}{2}s_{\rm smooth}\sum_c x_c^{\mathsf T}Q_{\rm SSP}x_c,\\
\phi_{\rm ridge}(z)&=\tfrac{1}{2}\lambda_{\rm num}\lVert z\rVert_2^2,\\
\sum_{p=1}^{P}x_{c,p}&=\alpha \quad (c\text{ participating}),\\
\Delta_{L_2}&=\frac{\mathrm{RSS}(x_{L_2})-\mathrm{RSS}(x_0)}{\mathrm{RSS}(x_0)}.
\end{align*}

