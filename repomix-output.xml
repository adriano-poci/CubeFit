                    ),
                    "sum": model_E,
                    "median_by_component": (
                        np.nanmedian(
                            E,
                            axis=1,
                        ).tolist()
                    ),
                    "median_by_population": (
                        np.nanmedian(
                            E,
                            axis=0,
                        ).tolist()
                    ),
                    "solver_S_stats": qstats(
