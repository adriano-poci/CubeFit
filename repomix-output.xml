                        s_full[cc] - s_proj[cc]
                    )
                    ratio = float(
                        s_full[cc]
                        / max(s_proj[cc], 1e-30)
                    )

                    print(
                        f"orbit {cc:2d}: "
                        f"mass={s_full[cc]:.3e} "
                        f"target={s_proj[cc]:.3e} "
                        f"resid={resid:+.3e} "
                        f"ratio={ratio:7.3f} "
                        f"nz="
                        f"{int(np.count_nonzero(x[cc, :] > 0.0)):3d} "
                        f"eff={st['eff_support']:.2f} "
                        f"top={st['top_share']:.2f}",
                        flush=True,
                    )

                _emit_diag(
                    {
                        "kind": "epoch_orbit_table",
                        "alpha": float(alpha_outer),
                        "orbit_shape": (
                            orbit_shape_outer.tolist()
                        ),
                        "orbit_mass": s_full.tolist(),
                        "orbit_target": s_proj.tolist(),
                        "orbit_resid": (
                            s_full - s_proj
                        ).tolist(),
                        "orbit_ratio": (
                            s_full
                            / np.maximum(
