            else:
                reconstruct_modelcube_fast_parallel(
                    h5_path=str(hdf5Path),
                    x_cp=x_global,
                    s_chunk=None,
                    out_dtype="float64",
                    rdcc_slots=1_000_003,
                    rdcc_bytes=8 * 1024**2,
                    rdcc_w0=0.90,
                    n_workers=builtins.min(best_processes, nTiles),
                    blas_threads_per_worker=best_blas,
