            r20["dims"]["L"],
        )

        coarse_in_fine = coarse_model_in_fine_basis_vectorised(
            f3,
            f20,
            X3,
            s_sel,
            p_sel,
            keep3,
            keep20,
            p_block=4,
        )
        p3 = []
        p20 = []

        for s in s_sel:
            A3 = np.asarray(
                f3["/HyperCube/models"][int(s)],
                dtype=np.float64,
            )

            A20 = np.asarray(
                f20["/HyperCube/models"][int(s)],
                dtype=np.float64,
            )

            p3.append(
                np.tensordot(
                    A3[:, :, keep3],
                    X3,
                    axes=([0, 1], [0, 1]),
                )
            )

            p20.append(
                np.tensordot(
                    A20[:, :, keep20],
                    X20,
