#!/bin/bash

while getopts ":g:" arg; do
  case $arg in
    g) galax=$OPTARG;;
  esac
done

curdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QUEUE="cmb"
NodeMem=273
nCPU=32

memPerCPU=$(echo "scale=2; $NodeMem*0.99 / $nCPU" | bc)
