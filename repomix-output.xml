        bulgeComps = np.setdiff1d(np.arange(nComp), diskComps)
    else:
        otypes = copy(nzComp) - 1
        diskComps = bulgeComps = None
    
    c3Path = '/data/phys-gal-dynamics/phys2603/CubeFit/NGC4365/hypercube_3_00.h5'
