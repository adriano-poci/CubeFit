    )

    p20 = np.asarray(
        p20,
        dtype=np.float64,
    )

    dp = p20 - p3

    comparison = {
        "static_inputs": static,
        "summed_losvd": losvd_cmp,
        "solution_scale": {
            "x_sum_ratio_20_over_3": ratio(
                r20["solution"]["sum"],
