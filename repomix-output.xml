            ]["regularisation_scale"],
            "c20": r20[
                "metadata"
            ]["regularisation_scale"],
        },
    }

    result["comparison"] = comparison

    r3.pop(
        "_shape_vectors",
        None,
    )

    r20.pop(
        "_shape_vectors",
        None,
    )

    if verbose:
        print(
            "=== HyperCube scaling diagnostic ==="
        )

        for label, rr in (
            ("C3", r3),
            ("C20", r20),
        ):
            print(
                f"{label}: "
                f"C={rr['dims']['C']} "
                f"P={rr['dims']['P']} "
                f"norm={rr['metadata']['norm_mode']} "
                f"amp={rr['metadata']['losvd_amplitude_mode']}"
